<UserControl x:Class="GamePassCatalogBrowser.Views.CatalogBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GamePassCatalogBrowser"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1200">
    <Grid>
        <Grid.Resources>
            <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" />
            <Style x:Key="SubTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="Foreground" Value="Gray" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter Property="Foreground" Value="#FF202020" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid HorizontalAlignment="Left" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Row 0: All controls in one compact row -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource LOCGamePass_Catalog_Browser_WindowViewCollectionLabel}" VerticalAlignment="Center"/>
                        <ComboBox Name="ComboBoxCollections" ItemsSource="{Binding Collections}" IsSynchronizedWithCurrentItem="True"
                                  Margin="8,0,0,0" MinWidth="140" MaxWidth="220"/>
                                  
                        <TextBlock Text="{DynamicResource LOCGamePass_Catalog_Browser_WindowViewCategoryLabel}" Margin="20,0,0,0" VerticalAlignment="Center"/>
                        <ComboBox Name="ComboBoxCategories" ItemsSource="{Binding Categories}" IsSynchronizedWithCurrentItem="True"
                                  Margin="8,0,0,0" MinWidth="100" MaxWidth="180"/>
                                  
                        <TextBlock Text="{DynamicResource LOCGamePass_Catalog_Browser_WindowViewSearchLabel}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        <TextBox Text="{Binding SearchString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=200}" 
                                 Margin="8,0,0,0" Width="180" VerticalAlignment="Center"/>
                                 
                        <Button Content="↻ Refresh" Command="{Binding RefreshCommand}" Padding="8,2" Margin="20,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <CheckBox Grid.Row="1" IsChecked="{Binding ShowGamesOnLibrary}"
                              Content="Show games that are already in the Playnite library" Margin="0,10,0,0" VerticalAlignment="Center"/>
                </Grid>
                <ListBox Grid.Row="2" Name="ListBoxGames" Margin="0,10,0,0" ItemsSource="{Binding GamePassGames}" SelectedItem="{Binding SelectedGamePassGame}" IsSynchronizedWithCurrentItem="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        BorderThickness="0"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="3" Background="#33000000">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,3,0,0" Width="150" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                        <TextBlock Text="{Binding PlatformAndServiceLabel}" FontSize="10" Style="{StaticResource SubTextStyle}" TextTrimming="CharacterEllipsis" Margin="0,1,0,3" ToolTip="{Binding PlatformAndServiceLabel}"/>
                                    </StackPanel>
                                    <Image Width="150" Height="225"
                                       Source="{Binding CoverImageLowRes, IsAsync=True, Converter={StaticResource ImageStringToImageConverter}}"
                                       DockPanel.Dock="Top"
                                       Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <Grid Grid.Column="1" Margin="10,20,0,0" Width="400">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=ListBoxGames, Path=SelectedItem}" Value="{x:Null}" >
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="{DynamicResource FontSizeLargest}" TextWrapping="Wrap" 
                                   Text="{Binding ElementName=ListBoxGames, Path=SelectedItem.Name}" VerticalAlignment="Center" 
                                   Margin="0,0,80,0"/>
                        <Button Grid.Column="1" Content="Close" VerticalAlignment="Top" 
                                Command="{Binding ClearSelectionCommand}" Padding="10,2" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Name="OverviewDeveloperLabel"  Content="{DynamicResource LOCGamePass_Catalog_Browser_WindowViewDeveloperLabel}"/>
                        <Label Grid.Row="0" Grid.Column="1" Margin="10,0,0,0"
                                Content="{Binding ElementName=ListBoxGames, Path=SelectedItem.Developers, Converter={StaticResource ListToStringConverter}}"/>
                        <Label Grid.Row="1" Grid.Column="0" Name="OverviewPublisherLabel" Content="{DynamicResource LOCGamePass_Catalog_Browser_WindowViewPublisherLabel}"/>
                        <Label Grid.Row="1" Grid.Column="1" Margin="10,0,0,0"
                                Content="{Binding ElementName=ListBoxGames, Path=SelectedItem.Publishers, Converter={StaticResource ListToStringConverter}}"/>
                        <Label Grid.Row="2" Grid.Column="0" Name="OverviewCategoryLabel" Content="{DynamicResource LOCGamePass_Catalog_Browser_WindowViewCategoryLabel}"/>
                        <Label Grid.Row="2" Grid.Column="1" Margin="10,0,0,0"
                                Content="{Binding ElementName=ListBoxGames, Path=SelectedItem.Category}"/>
                        <Label Grid.Row="3" Grid.Column="0" Name="OverviewAvailabilityLabel" Content="Availability:"/>
                        <Label Grid.Row="3" Grid.Column="1" Margin="10,0,0,0"
                                Content="{Binding ElementName=ListBoxGames, Path=SelectedItem.PlatformAndServiceLabel}"/>
                    </Grid>
                    <WrapPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="{DynamicResource LOCGamePass_Catalog_Browser_WindowViewOpenInXboxApp}" Command="{Binding XboxAppViewCommand}" CommandParameter="{Binding SelectedItem, ElementName=ListBoxGames}" DockPanel.Dock="Left" Padding="5" Margin="0,0,5,5"/>
                        <Button Content="{DynamicResource LOCGamePass_Catalog_Browser_WindowViewOpenInStore}" Command="{Binding StoreViewCommand}" CommandParameter="{Binding SelectedItem, ElementName=ListBoxGames}" DockPanel.Dock="Left" Padding="5" Margin="0,0,5,5"/>
                        <Button Content="{DynamicResource LOCGamePass_Catalog_Browser_WindowViewAddToLibrary}" Command="{Binding AddGameToLibraryCommand}" CommandParameter="{Binding SelectedItem, ElementName=ListBoxGames}" DockPanel.Dock="Left" Padding="5" Margin="0,0,5,5"/>
                    </WrapPanel>
                </StackPanel>

                <ScrollViewer  VerticalScrollBarVisibility="Auto" Margin="0,20,0,0" Grid.Row="1">
                    <TextBlock TextWrapping="Wrap"
                               Text="{Binding ElementName=ListBoxGames, Path=SelectedItem.Description}"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>